# Copy to `.env.dev` (or `.env.prod`) -- see `config/environment.py` for how the active file is
# selected. `.env.*` is gitignored; only this example is tracked. The deployments' files are
# `.env.prod` and `.env.staging`, also at the repo root (see README.md, Configuration).

# Django settings
SECRET_KEY=<DJANGO_SECRET_KEY>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Unset: SQLite (`db.sqlite3`), fine for local development. Required in production.
# DATABASE_URL=postgres://ziptrigo:<PASSWORD>@127.0.0.1:5432/ziptrigo

# Base URL used to build absolute links (emails, QR code redirects). Also the trusted CSRF origin,
# and `https://` makes the session and CSRF cookies Secure.
BASE_URL=http://localhost:8000

# JWT signing for the `/api/` endpoints. Separate from `SECRET_KEY` so it can be rotated on its own.
JWT_SECRET=<JWT_SIGNING_SECRET>
JWT_ALGORITHM=HS256
JWT_EXP_DELTA_SECONDS=1209600

# Comma-separated list of email backends. Supported kinds: `console`, `ses`.
EMAIL_BACKENDS=console
AWS_SES_SENDER=no-reply@ziptrigo.com

# Token lifetimes (hours). Email confirmation's other knobs (code length, max attempts, resend
# cooldown) are configured through the admin's Core Settings page instead.
PASSWORD_RESET_TOKEN_TTL_HOURS=4
EMAIL_CONFIRMATION_TOKEN_TTL_HOURS=48

# Rate limiting (apps.core.ratelimit, issue #53). Unset: on in dev/prod, off under pytest. The
# per-rule limits themselves (login, signup, QR preview, ...) are `settings.RATELIMIT_RULES`, a
# plain dict in `config/settings.py` -- not environment variables, to keep this file from growing
# one entry per rule; edit that dict directly to retune a limit.
# RATELIMIT_ENABLE=True

# Cache backing rate limiting (and, on the 'default' alias, general caching). Unset: Postgres
# (`django.core.cache.backends.db.DatabaseCache`, table created by a migration -- no extra setup),
# shared across every gunicorn worker without a new service. Set to point both aliases at Redis
# instead (needs the `redis` package installed; not a hard dependency of this project since it's
# opt-in), e.g. for a deployment with a Redis already available:
# CACHE_URL=redis://localhost:6379/0

# This project uses an IAM User Key/Secret and that user assumes a role temporarily.
# Only needed when `EMAIL_BACKENDS` includes `ses`.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
AWS_ROLE=<ROLE_ARN_TO_ASSUME>

# File transfer storage (S3). In production these come from the `infra` repo
# (`apps/ziptrigo-apps`, output `file_transfer_env`), written into the scp'd env file with the
# other secrets; the site refuses to start with ENVIRONMENT=prod while the key or secret is a
# placeholder. In dev, use Floci (`docker-compose.floci.yml`): set the endpoint below and any
# key/secret works, e.g. `test`.
FILE_TRANSFER_S3_BUCKET=ziptrigo-dev
# FILE_TRANSFER_S3_REGION=us-east-1           # defaults to AWS_REGION
FILE_TRANSFER_S3_ENDPOINT_URL=http://localhost:4566
FILE_TRANSFER_AWS_ACCESS_KEY_ID=<FILE_TRANSFER_ACCESS_KEY_ID>
FILE_TRANSFER_AWS_SECRET_ACCESS_KEY=<FILE_TRANSFER_SECRET_ACCESS_KEY>
