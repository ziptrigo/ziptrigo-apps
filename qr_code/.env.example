# Copy to `.env.dev` (or `.env.prod`) -- see `shared/utils/utils/environment.py` for how the
# active file is selected. `.env.*` is gitignored; only this example is tracked.

# Django settings
SECRET_KEY=<DJANGO_SECRET_KEY>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base URL used to build QR code redirect links
BASE_URL=http://localhost:8020

# Comma-separated list of email backends. Supported kinds: `console`, `ses`.
EMAIL_BACKENDS=console
AWS_SES_SENDER=no-reply@ziptrigo.com

# Token lifetimes (hours)
PASSWORD_RESET_TOKEN_TTL_HOURS=4
EMAIL_CONFIRMATION_TOKEN_TTL_HOURS=48

# This project uses an IAM User Key/Secret and that user assumes a role temporarily.
# Only needed when `EMAIL_BACKENDS` includes `ses`.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
AWS_ROLE=<ROLE_ARN_TO_ASSUME>
